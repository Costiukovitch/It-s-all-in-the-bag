{"id":4,"name":"Кузнец","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":12,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"npcs_2","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["people",2,0,2,""]},{"code":401,"indent":0,"parameters":["Вот, держи, вот такая есть шляпа, приятной "]},{"code":401,"indent":0,"parameters":["носки!"]},{"code":101,"indent":0,"parameters":["Fa_Actor1",1,0,2,""]},{"code":401,"indent":0,"parameters":["Погоди, так ты же просто достал её с полки, а "]},{"code":401,"indent":0,"parameters":["не сделал?"]},{"code":101,"indent":0,"parameters":["people",2,0,2,""]},{"code":401,"indent":0,"parameters":["Ну да, я же кузнец, а не портной, я больше с "]},{"code":401,"indent":0,"parameters":["металлом работаю, чем с пошивом."]},{"code":101,"indent":0,"parameters":["Fa_Actor1",1,0,2,""]},{"code":401,"indent":0,"parameters":["А зачем тогда меня послали именно к тебе?"]},{"code":101,"indent":0,"parameters":["people",2,0,2,""]},{"code":401,"indent":0,"parameters":["Хмм, ты же тот самый алхимик с окраины, верно?"]},{"code":101,"indent":0,"parameters":["Fa_Actor1",1,0,2,""]},{"code":401,"indent":0,"parameters":["Ну да, а это сильно влияет?"]},{"code":101,"indent":0,"parameters":["people",2,0,2,""]},{"code":401,"indent":0,"parameters":["Ну конечно, мы помним, как раньше ты нам помогал "]},{"code":401,"indent":0,"parameters":["своими зельями, а потом закрылся в лаборатории "]},{"code":401,"indent":0,"parameters":["и перестал выходить к нам, ничего при этом не "]},{"code":401,"indent":0,"parameters":["сказав."]},{"code":101,"indent":0,"parameters":["people",2,0,2,""]},{"code":401,"indent":0,"parameters":["Пока ты меня спасал, снова пообщался со всеми "]},{"code":401,"indent":0,"parameters":["жителями, помог им. Я тебе больше скажу: в этих "]},{"code":401,"indent":0,"parameters":["шляпах нет смысла, мы их начали носить только "]},{"code":401,"indent":0,"parameters":["сегодня, когда доставили тебе письмо. "]},{"code":101,"indent":0,"parameters":["people",2,0,2,""]},{"code":401,"indent":0,"parameters":["Мы хотим, чтобы и ты не забывал, что мы друг "]},{"code":401,"indent":0,"parameters":["без друга не проживем, например, пекарь и рыбак "]},{"code":401,"indent":0,"parameters":["нас обеспечивают едой, я даю инструменты. "]},{"code":101,"indent":0,"parameters":["people",2,0,2,""]},{"code":401,"indent":0,"parameters":["Но порой появляются задачи, которые нам без "]},{"code":401,"indent":0,"parameters":["тебя не решить. Поэтому мы были бы очень рады, "]},{"code":401,"indent":0,"parameters":["если ты не будешь забывать о нас..."]},{"code":101,"indent":0,"parameters":["Fa_Actor1",1,0,2,""]},{"code":401,"indent":0,"parameters":["Правда? Мне казалось, что мои зелья особо "]},{"code":401,"indent":0,"parameters":["никому и не нужны были, спасибо, что сказал, "]},{"code":401,"indent":0,"parameters":["я обязательно буду навещать вас почаще."]},{"code":221,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Команда Git Gud Devs благодарит вас за прохождение игры!"]},{"code":401,"indent":0,"parameters":["@VladixGD - капитан и разработчик"]},{"code":401,"indent":0,"parameters":["@emeraa - разработчик"]},{"code":401,"indent":0,"parameters":["@Whoke_tt - дизайнер"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["@darkperson0_0 - дизайнер и саунд"]},{"code":401,"indent":0,"parameters":["@heroengel0849 - дизайнер"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Игра создана для Siberian Game Jam Май 2026."]},{"code":401,"indent":0,"parameters":["При поддержке GameDev сообщества ТюмГУ \"Ctrl+Z\""]},{"code":401,"indent":0,"parameters":[""]},